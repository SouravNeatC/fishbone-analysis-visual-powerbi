{
    "dataRoles": [
        {
            "displayName": "Main Cause (Category)",
            "name": "mainCause",
            "kind": "Grouping",
            "description": "Main fishbone categories, such as People, Methods, Materials, Equipment."
        },
        {
            "displayName": "Sub-Cause",
            "name": "subCause",
            "kind": "Grouping",
            "description": "Cause labels that appear inside the fishbone chevrons."
        },
        {
            "displayName": "Tooltips",
            "name": "tooltips",
            "kind": "Measure",
            "description": "Optional measures to show in the Power BI tooltip."
        }
    ],
    "dataViewMappings": [
        {
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "bind": {
                                "to": "mainCause"
                            }
                        },
                        {
                            "bind": {
                                "to": "subCause"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 1000
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "for": {
                                "in": "tooltips"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "objects": {
        "fishboneSettings": {
